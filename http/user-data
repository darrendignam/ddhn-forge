#cloud-config
# Ubuntu 24.04 LTS autoinstall, replacing the Debian preseed.
#
# Ubuntu Server is used rather than the Linux Mint ISO because Mint ships Ubiquity, the
# live-session installer, which has no supported unattended path. Subiquity autoinstall
# does, and the MATE desktop plus Mint's theming is applied by Ansible afterwards. The
# result is the Mint desktop on a base that can be built unattended.
autoinstall:
  version: 1
  interactive-sections: []

  locale: en_US.UTF-8
  keyboard:
    layout: us

  identity:
    hostname: viper
    username: vagrant
    # "vagrant", the throwaway build account. The Packer shutdown command locks it, so
    # the shipped image has no usable login for it.
    password: "$6$rounds=4096$c2FsdHNhbHQ$5Gv/WoRwyAqEPFuGVoFLDBNOwojzrUw.wf0Ny8lvdBGCgYG9GWl.DNfrG3meeFEGuyPM2o.Zti92gXnqDVute0"

  ssh:
    install-server: true
    allow-pw: true

  # Deliberately minimal. viper.setup runs a dist-upgrade as its first task, so doing it
  # here duplicates work inside the installer, where it counts against Packer's
  # ssh_timeout rather than against the provisioner.
  packages:
    - sudo
    - openssh-server
    - build-essential
  updates: security

  storage:
    layout:
      name: direct

  timezone: Europe/Berlin

  # Every entry is quoted. An unquoted plain scalar containing ": " is parsed by YAML
  # as a mapping, not a string, and subiquity then rejects the whole file with
  # "Malformed autoinstall in 'late-commands' section" before it installs anything.
  # The sudoers line below contains "NOPASSWD: ALL" and hit exactly that.
  late-commands:
    # Packer's shell provisioners call sudo non-interactively.
    - "curtin in-target -- sh -c 'echo \"vagrant ALL=(ALL) NOPASSWD: ALL\" > /etc/sudoers.d/vagrant'"
    - "curtin in-target -- sh -c 'chmod 440 /etc/sudoers.d/vagrant'"
    # Ubuntu Server enables unattended-upgrades, which grabs the apt lock and makes the
    # first Ansible task fail intermittently.
    - "curtin in-target -- sh -c 'systemctl disable --now unattended-upgrades || true'"
