#cloud-config
# Cloud-init configuration for ViPER ARM64

# Set hostname
hostname: viper-arm64

# Configure users
users:
  - name: debian
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: false
    # Password is 'debian' (SHA512 hash)
    passwd: $6$rdzDj5k7uszs.fdn$DVEIRmSSsPFSWlGhHG129/R.bfJce8PHESVu9W9lR/8jBQr0P.vVk7ocRclff8f/zSi9vkDrs4fSRiY5oAJaS/
    ssh_authorized_keys: []
  - name: vagrant
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: false
    # Password is 'vagrant' (SHA512 hash)
    passwd: $6$FmmU11JankZabtie$I1WrQbEavNKq6bldaMOSa7sj.UD.Yrzse7K5sApejgTDAO7g0tvCP.1gs3WpIbfvfGhb1VCJBW9VauYHHikli0

# Enable password authentication for SSH (for Packer)
ssh_pwauth: true

# Run commands on first boot
runcmd:
  - echo "Cloud-init setup complete for ViPER ARM64"
  - systemctl enable ssh
  - systemctl start ssh

# Set timezone
timezone: UTC

# Package updates
package_update: true
package_upgrade: false

# Grow root partition to fill disk
growpart:
  mode: auto
  devices: ['/']

# Final message
final_message: "ViPER ARM64 cloud-init complete after $UPTIME seconds"
